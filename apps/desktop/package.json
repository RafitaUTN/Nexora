{
    "name": "documind",
    "version": "0.1.0",
    "private": true,
    "description": "DocuMind Desktop — Gestión inteligente de documentos",
    "type": "module",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "start": "electron-vite preview",
        "build": "electron-vite build",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
        "build:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
        "build:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
        "publish:win": "npm run build && electron-builder --win --config electron-builder.yml --publish always",
        "publish:mac": "npm run build && electron-builder --mac --config electron-builder.yml --publish always",
        "publish:linux": "npm run build && electron-builder --linux --config electron-builder.yml --publish always"
    },
    "dependencies": {
        "chokidar": "^3.6.0",
        "electron-updater": "^6.8.9",
        "exceljs": "^4.4.0",
        "mammoth": "^1.8.0",
        "pdfjs-dist": "^4.10.38",
        "sharp": "^0.35.3",
        "tesseract.js": "^5.1.1"
    },
    "devDependencies": {
        "@documind/ai": "0.1.0",
        "@documind/core": "0.1.0",
        "@documind/document": "0.1.0",
        "@documind/domain": "0.1.0",
        "@documind/ocr": "0.1.0",
        "@documind/shared": "0.1.0",
        "@electron/notarize": "^2.5.0",
        "@napi-rs/canvas": "^0.1.54",
        "@tanstack/react-query": "^5.51.23",
        "@tanstack/react-virtual": "^3.10.8",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "app-builder-bin": "^4.2.0",
        "autoprefixer": "^10.4.20",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.0.0",
        "electron": "^43.0.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "framer-motion": "^11.3.29",
        "lucide-react": "^0.436.0",
        "postcss": "^8.4.41",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.52.2",
        "react-router-dom": "^7.18.2",
        "tailwind-merge": "^2.5.2",
        "tailwindcss": "^3.4.10",
        "tailwindcss-animate": "^1.0.7",
        "vite": "^7.3.6",
        "zod": "^3.23.8",
        "zustand": "^4.5.5"
    }
}
