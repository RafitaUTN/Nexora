{
  "name": "documind-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DocuMind Desktop — Gestión inteligente de documentos para PYMES",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "build:win": "npm run build:win -w apps/desktop",
    "build:mac": "npm run build:mac -w apps/desktop",
    "build:linux": "npm run build:linux -w apps/desktop",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w apps/desktop",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "smoke": "npm run smoke:document && npm run smoke:ocr && npm run smoke:index && npm run smoke:main && npm run smoke:automations",
    "smoke:document": "tsx scripts/smoke-document.ts",
    "smoke:ocr": "tsx scripts/smoke-ocr.ts",
    "smoke:index": "tsx scripts/smoke-index.ts",
    "smoke:main": "tsx scripts/smoke-main.ts",
    "smoke:automations": "tsx scripts/smoke-automations.ts",
    "audit": "npm audit --audit-level=high",
    "audit:code": "node scripts/audit-code.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.5.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitest/coverage-v8": "^2.0.5",
    "docx": "^9.7.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "node-gyp": "^13.0.1",
    "pdfkit": "^0.19.1",
    "prettier": "^3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
